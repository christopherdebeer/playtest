{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "game-state": {
      "type": "object",
      "required": ["fileType", "version", "timestamp", "game", "gameId", "turnNumber", "gameActive", "players"],
      "properties": {
        "fileType": {
          "type": "string",
          "const": "game-state"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "game": {
          "type": "string"
        },
        "gameId": {
          "type": "string"
        },
        "turnNumber": {
          "type": "integer",
          "minimum": 1
        },
        "gameActive": {
          "type": "boolean"
        },
        "players": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/definitions/player"
          }
        },
        "currentPlayer": {
          "type": "string"
        },
        "direction": {
          "type": "integer",
          "enum": [1, -1]
        }
      }
    },
    "turn-signal": {
      "type": "object",
      "required": ["fileType", "version", "timestamp", "gameId", "turnNumber", "currentPlayer"],
      "properties": {
        "fileType": {
          "type": "string",
          "const": "turn-signal"
        },
        "version": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "gameId": {
          "type": "string"
        },
        "turnNumber": {
          "type": "integer",
          "minimum": 1
        },
        "currentPlayer": {
          "type": "string"
        },
        "availableActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["play", "draw", "challenge", "call_uno"]
          }
        },
        "visibleState": {
          "type": "object"
        }
      }
    },
    "player-action": {
      "type": "object",
      "required": ["fileType", "version", "timestamp", "gameId", "playerId", "turnNumber", "action"],
      "properties": {
        "fileType": {
          "type": "string",
          "const": "player-action"
        },
        "version": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "gameId": {
          "type": "string"
        },
        "playerId": {
          "type": "string"
        },
        "turnNumber": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string",
          "enum": ["play", "draw", "challenge", "call_uno"]
        },
        "card": {
          "$ref": "#/definitions/card"
        },
        "reasoning": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "player": {
      "type": "object",
      "required": ["id", "cardCount", "score", "isActive"],
      "properties": {
        "id": {
          "type": "string"
        },
        "cardCount": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "isActive": {
          "type": "boolean"
        },
        "calledUno": {
          "type": "boolean"
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["color", "value"],
      "properties": {
        "color": {
          "type": "string",
          "enum": ["Red", "Yellow", "Green", "Blue", "Wild"]
        },
        "value": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["number", "action", "wild"]
        }
      }
    }
  }
}
