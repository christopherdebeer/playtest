{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game State",
  "description": "Authoritative game state - single source of truth",
  "type": "object",
  "required": ["gameId", "gameName", "version", "turnNumber", "currentPlayer", "players", "gameStatus"],
  "properties": {
    "gameId": {
      "type": "string",
      "description": "Unique identifier for this game instance (e.g., 'uno-1738063532000')"
    },
    "gameName": {
      "type": "string",
      "description": "Name of the game being played (e.g., 'uno', 'markovs-chains')"
    },
    "version": {
      "type": "string",
      "description": "Rules version (e.g., '1.0', '2.0')"
    },
    "turnNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "Current turn number (1-indexed)"
    },
    "currentPlayer": {
      "type": "string",
      "description": "Player ID whose turn it is (e.g., 'player-1')"
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum turns before game ends in draw (optional)"
    },
    "players": {
      "type": "object",
      "description": "Map of player IDs to player states",
      "patternProperties": {
        "^player-[0-9]+$": {
          "type": "object",
          "required": ["handSize"],
          "properties": {
            "hand": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Player's cards (PRIVATE - only visible to this player)"
            },
            "handSize": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of cards in hand (PUBLIC)"
            },
            "state": {
              "type": "string",
              "description": "Game-specific state (e.g., board position, status)"
            },
            "score": {
              "type": "integer",
              "description": "Player's current score (optional)"
            },
            "activeEffects": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Status effects currently on this player"
            },
            "blocked": {
              "type": "boolean",
              "description": "Whether player is prevented from acting (optional)"
            }
          }
        }
      }
    },
    "deck": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Remaining cards in draw pile"
    },
    "deckSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of cards remaining in deck"
    },
    "discardPile": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Cards that have been played/discarded"
    },
    "gameSpecific": {
      "type": "object",
      "description": "Custom fields specific to this game",
      "examples": [
        {"topCard": "Red 5", "direction": "clockwise"},
        {"edgeWeights": {"Start->A": 0.65}}
      ]
    },
    "winner": {
      "type": ["string", "null"],
      "description": "Player ID of winner, or null if game ongoing"
    },
    "gameStatus": {
      "type": "string",
      "enum": ["active", "completed", "cancelled"],
      "description": "Current status of the game"
    }
  }
}
