# ===========================================
# RUNTIME STATE (ignored - regenerated each game)
# ===========================================

# Active game state (recreated each playtest)
games/*/state/

# Hook trace logs (debug output)
logs/


# Lock files
*.lock

# ===========================================
# TRACKED: Logs and Debug Captures
# ===========================================
# These are NOT ignored - we want to retain historical results
# - games/*/logs/*.jsonl (live event logs)
# - games/*/logs/*.json (game summaries)
# - games/*/logs/debug/ (debug captures with timing analysis)
# - games/*/traces/ (game traces)

# BUT ignore backup archives (created by cleanup command)
games/*/logs-archive-*.tar.gz

# ===========================================
# LOCAL/USER-SPECIFIC
# ===========================================

# Local settings (user-specific, not committed)
.claude/*.local.md
.claude/*.local.json

# ===========================================
# BUILD OUTPUT
# ===========================================

engine/dist/
site/dist/
*.tsbuildinfo

# Generated site data (build-time artifacts)
site/src/data/*.json

# ===========================================
# DEPENDENCIES
# ===========================================

node_modules/

# ===========================================
# OS FILES
# ===========================================

.DS_Store
Thumbs.db
*~
*.swp

# Shared package build output
shared/dist/
