{
  "name": "playtest",
  "version": "0.1.0",
  "description": "A computational framework for game design exploration using LLM agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playtest": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "playtest": "node --loader ts-node/esm src/cli/index.ts"
  },
  "keywords": [
