{
  "name": "playtest",
  "version": "3.0.0",
  "description": "Game-agnostic AI playtesting framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "playtest": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:engine && npm run build:site",
    "build:engine": "tsc -p tsconfig.json",
    "build:site": "npm run build:engine && npm run generate && tsc -p tsconfig.site.json && vite build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:site": "npm run generate && vite",
    "generate": "npm run generate:registry && npm run generate:games && npm run generate:mechanics-index && npm run generate:mechanics && npm run generate:logs && npm run generate:docs",
    "generate:registry": "npx tsx scripts/generate-mechanics-registry.ts",
    "generate:games": "npx tsx site/scripts/generate-games.ts",
    "generate:mechanics-index": "npx tsx scripts/generate-mechanics-index.ts",
    "generate:mechanics": "npx tsx site/scripts/generate-mechanics-data.ts",
    "generate:logs": "node site/scripts/generate-logs.js",
    "generate:docs": "node site/scripts/generate-docs.js",
    "playtest": "node dist/cli/index.js",
    "pt": "node dist/cli/index.js",
    "pt:init": "node dist/cli/index.js init",
    "pt:status": "node dist/cli/index.js status",
    "pt:list": "node dist/cli/index.js list"
  },
  "keywords": [
    "game",
    "playtesting",
    "multi-agent",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "marked": "^17.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^4.0.18"
  }
}
