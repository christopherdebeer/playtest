{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "30000"
  },
  "permissions": {
    "allow": [
      "Skill(start-game *)",
      "Skill(view-results *)"
    ],
    "deny": [
      "Skill(stop-game *)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "player",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/player-start-hook.sh"
          }
        ]
      },
      {
        "matcher": "gamemaster",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/gamemaster-start-hook.sh"
          }
        ]
      }
    ],
    "SubagentStop": []
  }
}
