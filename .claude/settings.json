{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "30000"
  },
  "permissions": {
    "allow": [
      "Skill(start-game *)",
      "Skill(view-results *)"
    ],
    "deny": [
      "Skill(stop-game *)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "player",
        "hooks": [
          {
            "type": "command",
            "command": "npx playtest hook --name start --agent player"
          }
        ]
      },
      {
        "matcher": "gamemaster",
        "hooks": [
          {
            "type": "command",
            "command": "npx playtest hook --name start --agent gamemaster"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "player",
        "hooks": [
          {
            "type": "command",
            "command": "npx playtest hook --name stop --agent player"
          }
        ]
      },
      {
        "matcher": "gamemaster",
        "hooks": [
          {
            "type": "command",
            "command": "npx playtest hook --name stop --agent gamemaster"
          }
        ]
      }
    ]
  }
}
