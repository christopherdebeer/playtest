{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "30000"
  },
  "permissions": {
    "allow": [
      "Skill(playtest *)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook-event --event SessionStart"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "player",
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook --name start --agent player"
          }
        ]
      },
      {
        "matcher": "gamemaster",
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook --name start --agent gamemaster"
          }
        ]
      },
      {
        "matcher": "mechanic",
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook --name start --agent mechanic"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook-event --event SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "player",
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook --name stop --agent player"
          }
        ]
      },
      {
        "matcher": "gamemaster",
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook --name stop --agent gamemaster"
          }
        ]
      },
      {
        "matcher": "mechanic",
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook --name stop --agent mechanic"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./playtest hook-event --event SubagentStop"
          }
        ]
      }
    ]
  }
}
