{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "30000"
  },
  "permissions": {
    "allow": [
      "Skill(start-game *)",
      "Skill(view-results *)",
      "Skill(game-coordination)",
      "Skill(file-protocol)",
      "Skill(hook-sync)"
    ],
    "deny": [
      "Skill(stop-game *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/agent-stop-hook.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/gamemaster-stop-hook.sh"
          }
        ]
      }
    ]
  }
}
