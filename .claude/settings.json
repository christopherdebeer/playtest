{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "30000"
  },
  "permissions": {
    "allow": [
      "Skill(start-game *)",
      "Skill(view-results *)",
      "Skill(game-coordination)",
      "Skill(file-protocol)",
      "Skill(hook-sync)"
    ],
    "deny": [
      "Skill(stop-game *)"
    ]
  },
  "hooks": {
    "stop": {
      "enabled": true,
      "scripts": [
        ".claude/hooks/agent-stop-hook.sh",
        ".claude/hooks/gamemaster-stop-hook.sh"
      ]
    }
  }
}
